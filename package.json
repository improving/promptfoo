{
  "dependencies": {
    "ajv": "^8.20.0",
    "promptfoo": "^0.121.17"
  },
  "scripts": {
    "test": "promptfoo eval --no-cache --config ",
    "test:providers": "node --test tests/providers.test.js",
    "test:verbose": "node -e \"const arg=process.argv[1]; require('child_process').execSync('promptfoo eval --no-cache --verbose --config '+arg+' > test.log',{stdio:'inherit'})\" --",
    "view": "promptfoo view"
  }
}
